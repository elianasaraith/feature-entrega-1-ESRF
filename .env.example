# Conexion a PostgreSQL (ver docker-compose.yml para el entorno local)
DATABASE_URL=
DIRECT_URL=

# Autenticacion (T12 - acceso protegido de usuario unico)
AUTH_SECRET=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Proveedor de la UF (T10). Opcional: por defecto https://findic.cl/api/uf
UF_API_BASE_URL=https://findic.cl/api/uf

# Documentos (T11) - Cloudflare R2. Solo servidor; nunca NEXT_PUBLIC_*.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
