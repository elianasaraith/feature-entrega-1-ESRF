generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Moneda {
  UF
  CLP

  @@map("moneda")
}

// Restricciones de docs/data-model.md §4.2 (superficie_m2 > 0, valor_compra_monto > 0,
// sin decimales si la moneda es CLP) viven como CHECK en
// prisma/migrations/20261013120000_add_propiedad_check_constraints/migration.sql,
// porque Prisma no tiene un atributo de esquema para representarlas aquí.
model Propiedad {
  id                 String   @id @default(uuid()) @db.Uuid
  numeroDepartamento String   @map("numero_departamento")
  direccion          String?
  superficieM2       Decimal  @map("superficie_m2") @db.Decimal(8, 2)
  valorCompraMonto   Decimal  @map("valor_compra_monto") @db.Decimal(14, 4)
  valorCompraMoneda  Moneda   @map("valor_compra_moneda")
  fechaCompra        DateTime @map("fecha_compra") @db.Date
  estacionamiento    String?
  bodega             String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("propiedad")
}

// Usuario único del sistema (T12 — acceso protegido). docs/data-model.md §4.1:
// sin usuario_id en ninguna otra entidad, por ser un MVP de usuario único.
model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("usuario")
}
