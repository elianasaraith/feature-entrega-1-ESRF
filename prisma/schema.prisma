generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Moneda {
  UF
  CLP

  @@map("moneda")
}

// Restricciones de docs/data-model.md §4.2 (superficie_m2 > 0, valor_compra_monto > 0,
// sin decimales si la moneda es CLP) viven como CHECK en
// prisma/migrations/20261013120000_add_propiedad_check_constraints/migration.sql,
// porque Prisma no tiene un atributo de esquema para representarlas aquí.
model Propiedad {
  id                 String   @id @default(uuid()) @db.Uuid
  numeroDepartamento String   @map("numero_departamento")
  direccion          String?
  superficieM2       Decimal  @map("superficie_m2") @db.Decimal(8, 2)
  valorCompraMonto   Decimal  @map("valor_compra_monto") @db.Decimal(14, 4)
  valorCompraMoneda  Moneda   @map("valor_compra_moneda")
  fechaCompra        DateTime @map("fecha_compra") @db.Date
  estacionamiento    String?
  bodega             String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  credito CreditoHipotecario?

  @@map("propiedad")
}

// Condiciones contractuales del crédito (T02). docs/data-model.md §4.3.
// Sin columna de saldo vigente ni equivalentes en CLP (data-model §4.3,
// architecture §10.3). Los CHECK (cuota > 0, tasa >= 0, cuotas > 0, día 1..31,
// monto original > 0, seguros >= 0, saldo inicial >= 0) viven en la migración SQL.
model CreditoHipotecario {
  id                 String    @id @default(uuid()) @db.Uuid
  propiedadId        String    @unique @map("propiedad_id") @db.Uuid
  banco              String
  numeroCredito      String?   @map("numero_credito")
  fechaOtorgamiento  DateTime? @map("fecha_otorgamiento") @db.Date
  montoOriginalUf    Decimal?  @map("monto_original_uf") @db.Decimal(12, 4)
  cuotaContractualUf Decimal   @map("cuota_contractual_uf") @db.Decimal(12, 4)
  tasaInteresAnual   Decimal   @map("tasa_interes_anual") @db.Decimal(6, 4)
  numeroCuotasTotal  Int       @map("numero_cuotas_total")
  segurosUf          Decimal?  @map("seguros_uf") @db.Decimal(12, 4)
  diaVencimiento     Int       @map("dia_vencimiento") @db.SmallInt
  saldoInicialUf     Decimal?  @map("saldo_inicial_uf") @db.Decimal(12, 4)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  propiedad Propiedad                  @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  registros CreditoRegistroMensual[]

  @@map("credito_hipotecario")
}

// Serie mensual del crédito (T03). docs/data-model.md §4.4. `periodo` es la
// mensualidad (día 1); `fechaPagoDividendo` es la fecha de caja. Los CHECK
// (periodo día 1, dividendo > 0, saldo >= 0, al menos un dato, y fecha de pago
// nula si y solo si no hay dividendo) viven en la migración SQL.
model CreditoRegistroMensual {
  id                 String    @id @default(uuid()) @db.Uuid
  creditoId          String    @map("credito_id") @db.Uuid
  periodo            DateTime  @db.Date
  dividendoPagadoClp Decimal?  @map("dividendo_pagado_clp") @db.Decimal(14, 0)
  fechaPagoDividendo DateTime? @map("fecha_pago_dividendo") @db.Date
  saldoPendienteUf   Decimal?  @map("saldo_pendiente_uf") @db.Decimal(12, 4)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  credito CreditoHipotecario @relation(fields: [creditoId], references: [id], onDelete: Restrict)

  @@unique([creditoId, periodo])
  @@index([fechaPagoDividendo])
  @@map("credito_registro_mensual")
}

// Usuario único del sistema (T12 — acceso protegido). docs/data-model.md §4.1:
// sin usuario_id en ninguna otra entidad, por ser un MVP de usuario único.
model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("usuario")
}
