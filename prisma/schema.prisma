generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Moneda {
  UF
  CLP

  @@map("moneda")
}

// Restricciones de docs/data-model.md §4.2 (superficie_m2 > 0, valor_compra_monto > 0,
// sin decimales si la moneda es CLP) viven como CHECK en
// prisma/migrations/20261013120000_add_propiedad_check_constraints/migration.sql,
// porque Prisma no tiene un atributo de esquema para representarlas aquí.
model Propiedad {
  id                 String   @id @default(uuid()) @db.Uuid
  numeroDepartamento String   @map("numero_departamento")
  direccion          String?
  superficieM2       Decimal  @map("superficie_m2") @db.Decimal(8, 2)
  valorCompraMonto   Decimal  @map("valor_compra_monto") @db.Decimal(14, 4)
  valorCompraMoneda  Moneda   @map("valor_compra_moneda")
  fechaCompra        DateTime @map("fecha_compra") @db.Date
  estacionamiento    String?
  bodega             String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  credito     CreditoHipotecario?
  contratos   ContratoArriendo[]
  movimientos MovimientoFinanciero[]
  documentos  Documento[]

  @@map("propiedad")
}

// Condiciones contractuales del crédito (T02). docs/data-model.md §4.3.
// Sin columna de saldo vigente ni equivalentes en CLP (data-model §4.3,
// architecture §10.3). Los CHECK (cuota > 0, tasa >= 0, cuotas > 0, día 1..31,
// monto original > 0, seguros >= 0, saldo inicial >= 0, porcentaje de pie 0..100) viven en la migración SQL.
model CreditoHipotecario {
  id                 String    @id @default(uuid()) @db.Uuid
  propiedadId        String    @unique @map("propiedad_id") @db.Uuid
  banco              String
  numeroCredito      String?   @map("numero_credito")
  fechaOtorgamiento  DateTime? @map("fecha_otorgamiento") @db.Date
  montoOriginalUf    Decimal?  @map("monto_original_uf") @db.Decimal(12, 4)
  cuotaContractualUf Decimal   @map("cuota_contractual_uf") @db.Decimal(12, 4)
  tasaInteresAnual   Decimal   @map("tasa_interes_anual") @db.Decimal(6, 4)
  numeroCuotasTotal  Int       @map("numero_cuotas_total")
  segurosUf          Decimal?  @map("seguros_uf") @db.Decimal(12, 4)
  diaVencimiento     Int       @map("dia_vencimiento") @db.SmallInt
  saldoInicialUf     Decimal?  @map("saldo_inicial_uf") @db.Decimal(12, 4)
  porcentajePie      Decimal?  @map("porcentaje_pie") @db.Decimal(5, 2)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  propiedad Propiedad                @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  registros CreditoRegistroMensual[]
  documentos Documento[]

  @@map("credito_hipotecario")
}

// Serie mensual del crédito (T03). docs/data-model.md §4.4. `periodo` es la
// mensualidad (día 1); `fechaPagoDividendo` es la fecha de caja. Los CHECK
// (periodo día 1, dividendo > 0, saldo >= 0, al menos un dato, y fecha de pago
// nula si y solo si no hay dividendo) viven en la migración SQL.
model CreditoRegistroMensual {
  id                 String    @id @default(uuid()) @db.Uuid
  creditoId          String    @map("credito_id") @db.Uuid
  periodo            DateTime  @db.Date
  dividendoPagadoClp Decimal?  @map("dividendo_pagado_clp") @db.Decimal(14, 0)
  fechaPagoDividendo DateTime? @map("fecha_pago_dividendo") @db.Date
  saldoPendienteUf   Decimal?  @map("saldo_pendiente_uf") @db.Decimal(12, 4)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  credito CreditoHipotecario @relation(fields: [creditoId], references: [id], onDelete: Restrict)

  @@unique([creditoId, periodo])
  @@index([fechaPagoDividendo])
  @@map("credito_registro_mensual")
}

// Usuario único del sistema (T12 — acceso protegido). docs/data-model.md §4.1:
// sin usuario_id en ninguna otra entidad, por ser un MVP de usuario único.
model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("usuario")
}

// Persona que arrienda (T04). docs/data-model.md §4.5. Reutilizable entre
// contratos sucesivos. Sin usuario_id: MVP de usuario único (§4.1).
model Arrendatario {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  rut       String?  @unique
  email     String?
  telefono  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contratos ContratoArriendo[]

  @@map("arrendatario")
}

// Contrato de arriendo (T04). docs/data-model.md §4.6. Sin columna de monto ni
// de estado: el monto vive en `contrato_monto` y la vigencia se deriva de las
// fechas. Los CHECK (término >= inicio, garantía >= 0, día 1..31) viven en la
// migración SQL. El no solape entre contratos de una propiedad es validación
// de aplicación (con bloqueo por propiedad), no restricción de base de datos.
model ContratoArriendo {
  id              String   @id @default(uuid()) @db.Uuid
  propiedadId     String   @map("propiedad_id") @db.Uuid
  arrendatarioId  String   @map("arrendatario_id") @db.Uuid
  fechaInicio     DateTime @map("fecha_inicio") @db.Date
  fechaTermino    DateTime @map("fecha_termino") @db.Date
  garantiaClp     Decimal? @map("garantia_clp") @db.Decimal(14, 0)
  diaEsperadoPago Int      @map("dia_esperado_pago") @db.SmallInt
  observaciones   String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  propiedad    Propiedad       @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  arrendatario Arrendatario    @relation(fields: [arrendatarioId], references: [id], onDelete: Restrict)
  montos       ContratoMonto[]
  pagos        PagoEsperado[]
  documentos   Documento[]

  @@index([propiedadId, fechaInicio])
  @@index([arrendatarioId])
  @@map("contrato_arriendo")
}

// Histórico de montos de un contrato (docs/data-model.md §4.7). En T04 solo se
// crea la fila inicial; reajustes y nuevas filas son T05. `vigente_desde_periodo`
// es el día 1 del mes (CHECK en la migración).
model ContratoMonto {
  id                  String   @id @default(uuid()) @db.Uuid
  contratoId          String   @map("contrato_id") @db.Uuid
  montoMensualClp     Decimal  @map("monto_mensual_clp") @db.Decimal(14, 0)
  vigenteDesdePeriodo DateTime @map("vigente_desde_periodo") @db.Date
  motivo              String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contrato ContratoArriendo @relation(fields: [contratoId], references: [id], onDelete: Restrict)

  @@unique([contratoId, vigenteDesdePeriodo])
  @@map("contrato_monto")
}

// Lo que se espera cobrar de un contrato en un mes (docs/data-model.md §4.8).
// Solo se crea con la sincronización explícita (T05); `monto_esperado_clp` es un
// snapshot del monto vigente que un reajuste actualiza. `periodo` es día 1
// (CHECK en la migración). Sin estado: es derivado de los abonos (T06).
model PagoEsperado {
  id               String   @id @default(uuid()) @db.Uuid
  contratoId       String   @map("contrato_id") @db.Uuid
  periodo          DateTime @db.Date
  montoEsperadoClp Decimal  @map("monto_esperado_clp") @db.Decimal(14, 0)
  fechaEsperada    DateTime @map("fecha_esperada") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contrato ContratoArriendo @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  abonos   AbonoArriendo[]

  @@unique([contratoId, periodo])
  @@map("pago_esperado")
}

// Dinero efectivamente recibido contra un pago esperado (docs/data-model.md
// §4.9). Sin tope sobre el monto esperado. Borrado físico. Estado, saldo y fecha
// de completitud se derivan al consultar: nunca se persisten (T06).
model AbonoArriendo {
  id             String   @id @default(uuid()) @db.Uuid
  pagoEsperadoId String   @map("pago_esperado_id") @db.Uuid
  montoClp       Decimal  @map("monto_clp") @db.Decimal(14, 0)
  fechaRecepcion DateTime @map("fecha_recepcion") @db.Date
  medio          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  pagoEsperado PagoEsperado @relation(fields: [pagoEsperadoId], references: [id], onDelete: Restrict)
  documentos   Documento[]

  @@index([pagoEsperadoId])
  @@index([fechaRecepcion])
  @@map("abono_arriendo")
}

// Categorías de egreso manual (T07). Sin DIVIDENDO: el dividendo vive en
// credito_registro_mensual (docs/data-model.md §4.10, D1).
enum CategoriaMovimiento {
  REPARACION
  EQUIPAMIENTO
  SEGURO
  CONTRIBUCIONES
  GASTO_COMUN
  GASTO_EXTRAORDINARIO
  OTRO

  @@map("categoria_movimiento")
}

// Egreso manual de una propiedad (T07). docs/data-model.md §4.10. `fecha` es la
// fecha de caja. Sin columna `tipo`. El CHECK (monto_clp > 0) vive en la
// migración SQL.
model MovimientoFinanciero {
  id          String              @id @default(uuid()) @db.Uuid
  propiedadId String              @map("propiedad_id") @db.Uuid
  fecha       DateTime            @db.Date
  categoria   CategoriaMovimiento
  montoClp    Decimal             @map("monto_clp") @db.Decimal(14, 0)
  descripcion String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  propiedad Propiedad            @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  conceptos  MovimientoConcepto[]
  documentos Documento[]

  @@index([propiedadId, fecha])
  @@map("movimiento_financiero")
}

// Concepto de un gasto desglosado (T07, ampliación). Es parte del movimiento
// (composición), no un movimiento independiente: `monto_clp` del padre es el total
// y la suma de los conceptos, que mantiene el servicio. ON DELETE CASCADE: al
// eliminar el movimiento desaparecen sus conceptos. El CHECK (monto_clp > 0) vive
// en la migración SQL. Un movimiento sin conceptos es un gasto simple.
model MovimientoConcepto {
  id                     String   @id @default(uuid()) @db.Uuid
  movimientoFinancieroId String   @map("movimiento_financiero_id") @db.Uuid
  nombre                 String
  montoClp               Decimal  @map("monto_clp") @db.Decimal(14, 0)
  orden                  Int
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  movimiento MovimientoFinanciero @relation(fields: [movimientoFinancieroId], references: [id], onDelete: Cascade)

  @@index([movimientoFinancieroId])
  @@map("movimiento_concepto")
}

// Valor de la UF por período mensual (T10). docs/data-model.md §4.12. `periodo`
// es el día 1 del mes y es la PK: un valor por período que NO se sobrescribe
// (inserción idempotente en server/uf/uf-service.ts). `fechaValor` es el día
// cuyo valor se tomó (política: día 1). Los CHECK (valor_clp > 0, periodo día 1)
// viven en la migración SQL.
model ValorUfPeriodo {
  periodo    DateTime @id @db.Date
  valorClp   Decimal  @map("valor_clp") @db.Decimal(12, 2)
  fechaValor DateTime @map("fecha_valor") @db.Date
  fuente     String
  obtenidoEn DateTime @default(now()) @map("obtenido_en") @db.Timestamptz(6)

  @@map("valor_uf_periodo")
}

enum TipoDocumento {
  ESCRITURA
  CONTRATO_HIPOTECARIO
  CONTRATO_ARRIENDO
  COMPROBANTE_PAGO
  FACTURA
  OTRO

  @@map("tipo_documento")
}

// Metadata de un archivo en object storage (T11, docs/data-model.md §4.13).
// PostgreSQL nunca guarda el binario: `storage_key` lo referencia. Todo documento
// pertenece a una propiedad; los vínculos específicos son opcionales y excluyentes
// (CHECK en la migración SQL, junto con tamano_bytes > 0). Los vínculos a abono y
// movimiento, que sí pueden eliminarse, usan ON DELETE SET NULL: el documento
// sigue localizable desde su propiedad.
model Documento {
  id                     String        @id @default(uuid()) @db.Uuid
  propiedadId            String        @map("propiedad_id") @db.Uuid
  creditoId              String?       @map("credito_id") @db.Uuid
  contratoId             String?       @map("contrato_id") @db.Uuid
  abonoArriendoId        String?       @map("abono_arriendo_id") @db.Uuid
  movimientoFinancieroId String?       @map("movimiento_financiero_id") @db.Uuid
  tipo                   TipoDocumento
  nombreArchivo          String        @map("nombre_archivo")
  mimeType               String        @map("mime_type")
  tamanoBytes            BigInt        @map("tamano_bytes")
  storageKey             String        @unique @map("storage_key")
  subidoEn               DateTime      @default(now()) @map("subido_en") @db.Timestamptz(6)

  propiedad            Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  credito              CreditoHipotecario?   @relation(fields: [creditoId], references: [id], onDelete: SetNull)
  contrato             ContratoArriendo?     @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  abonoArriendo        AbonoArriendo?        @relation(fields: [abonoArriendoId], references: [id], onDelete: SetNull)
  movimientoFinanciero MovimientoFinanciero? @relation(fields: [movimientoFinancieroId], references: [id], onDelete: SetNull)

  @@index([propiedadId, subidoEn])
  @@map("documento")
}
